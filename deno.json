{
    "name": "@hoodie/signals",
    "version": "2.11.1",
    "license": "MIT",
    "exports": "./src/index.ts",

    "compilerOptions": {
        "lib": ["deno.window"]
    },
    "publish": {
        "exclude": [
            "test",
            "lib",
            "node_modules",
            "doc",
            ".npmignore",
            "package.json",
            "package-lock.json",
            "tsconfig.json"
        ]
    },
    "tasks": {
        "check": "deno check src/index.ts",
        "test": "deno test --no-config --unstable-sloppy-imports test/*.spec.ts"
    },
    "fmt": {
        "lineWidth": 100,
        "indentWidth": 4,
        "singleQuote": true,
        "exclude": ["README.md"]
    },
    "lint": {
        "rules": {
            "tags": ["recommended"],
            "exclude": [
                "no-explicit-any",
                "ban-types",
                "no-empty-interface",
                "no-non-null-assertion"
            ]
        }
    }
}
